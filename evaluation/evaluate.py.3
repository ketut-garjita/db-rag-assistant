"""
Evaluation suite for retrieval, generation, and NL-to-SQL generation.

1. Retrieval evaluation: compares FOUR approaches (semantic-only,
   keyword-only, hybrid, hybrid+cross-encoder-reranked) on hit-rate and
   MRR, and reports the best one — this is what's actually used in
   rag/pipeline.py (hybrid_search_reranked).

   Two question sets are supported and merged automatically if both
   exist on disk:
     - eval_questions.json             the original semantic-style set
     - eval_questions_categorized.json a set tagged with a "category"
       field (exact_code / abbreviation / paraphrase / lexical_trap /
       multi_hop_anchor / negation / numeric_threshold) specifically
       built to stress-test the hybrid+reranker path against naive
       semantic-only or keyword-only retrieval. When present, a
       per-category breakdown is printed for every approach so you can
       see exactly where hybrid_reranked earns its keep (or doesn't).

2. Generation evaluation: compares TWO system-prompt variants using
   LLM-as-judge (the LLM rates each generated answer's relevance to the
   question on a 1-5 scale), and reports the best-scoring variant — the
   "default" prompt (rag/generation.SYSTEM_PROMPT) is what's actually
   shipped in production.

3. SQL generation evaluation (new): uses a held-out set of
   (id, NL, SQL) pairs — sql_eval_questions.json — to check whether the
   assistant, when asked a natural-language question, produces a SQL
   query that matches the expected one after light normalization. This
   is a stricter, execution-oriented check on top of (1) and (2): it
   doesn't just ask whether the right table was retrieved or whether the
   answer sounds relevant, it checks whether a runnable, correct-looking
   query came out the other end.

Note: generation and SQL evaluation each make one or more LLM calls per
question. With a slow local model (e.g. Ollama on modest hardware) this
can take several minutes for even a handful of questions — reduce the
relevant eval set/limit or point OPENAI_BASE_URL at a faster model if
you just want a quick smoke test.

Usage:
    python evaluation/evaluate.py                                    # retrieval only (fast)
    python evaluation/evaluate.py --with-generation --generation-limit 10
    python evaluation/evaluate.py --with-sql-eval --sql-eval-limit 10
    python evaluation/evaluate.py --with-generation --with-sql-eval --show-sql-failures
"""
import json
import os
import re
import sys
import time

sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from openai import RateLimitError  # noqa: E402
from rag.config import LLM_MODEL  # noqa: E402
from rag.retrieval.retrieval import (  # noqa: E402
    semantic_search,
    keyword_search,
    hybrid_search,
    hybrid_search_reranked,
)
from rag.generation import _get_client, build_prompt, SYSTEM_PROMPT  # noqa: E402

EVAL_DIR = "/app/evaluation"
EVAL_QUESTIONS_PATH = os.path.join(EVAL_DIR, "eval_questions.json")
EVAL_QUESTIONS_CATEGORIZED_PATH = os.path.join(EVAL_DIR, "eval_questions_categorized.json")
SQL_EVAL_PATH = os.path.join(EVAL_DIR, "sql_eval_questions.json")

# --- LLM call throttling / retry -------------------------------------------
# Generation and SQL evaluation can fire dozens of LLM calls in a tight loop,
# which is enough to trip a provider's requests-per-minute limit (this is
# what happened with Groq's 30 RPM cap). MIN_INTERVAL_SECONDS proactively
# paces requests to stay under common free/on-demand tiers; MAX_RETRIES +
# exponential backoff handles the case where a limit is still hit anyway
# (e.g. another process sharing the same API key). Override via env vars or
# --llm-min-interval / --llm-max-retries if your provider's limit differs.
MIN_INTERVAL_SECONDS = float(os.environ.get("EVAL_LLM_MIN_INTERVAL", "2.5"))
MAX_RETRIES = int(os.environ.get("EVAL_LLM_MAX_RETRIES", "5"))
_last_call_at = [0.0]


def _throttle() -> None:
    elapsed = time.monotonic() - _last_call_at[0]
    if elapsed < MIN_INTERVAL_SECONDS:
        time.sleep(MIN_INTERVAL_SECONDS - elapsed)
    _last_call_at[0] = time.monotonic()


def _retry_after_seconds(error: RateLimitError) -> "float | None":
    """Best-effort parse of a suggested wait time from the error body (Groq
    and most OpenAI-compatible providers include one, e.g. "try again in
    2s"). Falls back to exponential backoff when not present/parseable."""
    match = re.search(r"try again in ([\d.]+)\s*s", str(error), re.IGNORECASE)
    return float(match.group(1)) + 0.5 if match else None


def chat_completion_with_retry(client, **kwargs):
    """Wraps client.chat.completions.create with proactive throttling and
    retry-with-backoff on rate-limit errors, so a single busy provider
    doesn't crash a whole evaluation run."""
    for attempt in range(1, MAX_RETRIES + 1):
        _throttle()
        try:
            return client.chat.completions.create(**kwargs)
        except RateLimitError as e:
            if attempt == MAX_RETRIES:
                raise
            wait = _retry_after_seconds(e) or min(2 ** attempt, 30)
            print(
                f"[warn] rate limited (attempt {attempt}/{MAX_RETRIES}), "
                f"retrying in {wait:.1f}s...",
                file=sys.stderr,
            )
            time.sleep(wait)


def _load_json(path: str) -> list[dict]:
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)


def load_eval_set(paths: "list[str] | None" = None) -> list[dict]:
    """Loads and merges one or more retrieval eval sets.

    Defaults to eval_questions.json plus eval_questions_categorized.json
    when the latter exists on disk. Items from the categorized file carry
    a "category" key; items from the plain file don't — both are treated
    identically for hit-rate/MRR, and the category field is used only for
    the optional breakdown below.
    """
    if paths is None:
        paths = [EVAL_QUESTIONS_PATH]
        if os.path.exists(EVAL_QUESTIONS_CATEGORIZED_PATH):
            paths.append(EVAL_QUESTIONS_CATEGORIZED_PATH)

    merged: list[dict] = []
    for path in paths:
        if not os.path.exists(path):
            continue
        items = _load_json(path)
        valid = [it for it in items if "question" in it and "expected_table" in it]
        skipped = len(items) - len(valid)
        if skipped:
            print(
                f"[warn] {path}: skipping {skipped} item(s) missing 'question'/'expected_table' "
                f"(if this file actually has 'id'/'NL'/'SQL' keys, it's the SQL eval set — "
                f"point --sql-eval-path at it instead of using it here).",
                file=sys.stderr,
            )
        merged.extend(valid)
    if not merged:
        print(
            f"[warn] load_eval_set() found no usable items in {paths}. "
            "Check that eval_questions.json exists and has 'question'/'expected_table' keys.",
            file=sys.stderr,
        )
    return merged


def load_sql_eval_set(path: str = SQL_EVAL_PATH) -> list[dict]:
    return _load_json(path)


# =============================================================================
# 1. Retrieval evaluation — compare multiple approaches
# =============================================================================

RETRIEVAL_APPROACHES = {
    "semantic_only": semantic_search,
    "keyword_only": keyword_search,
    "hybrid": hybrid_search,
    "hybrid_reranked": hybrid_search_reranked,  # what rag/pipeline.py actually uses
}


def evaluate_retrieval_approach(search_fn, eval_set: list[dict], top_k: int = 5) -> dict:
    hits = 0
    reciprocal_ranks = []
    category_stats: dict = {}

    for item in eval_set:
        results = search_fn(item["question"], top_k=top_k)
        tables_retrieved = [r.get("table_name") for r in results]

        category = item.get("category")
        if category and category not in category_stats:
            category_stats[category] = {"hits": [], "rr": []}

        if item["expected_table"] in tables_retrieved:
            hits += 1
            rank = tables_retrieved.index(item["expected_table"]) + 1
            rr = 1 / rank
            hit = 1
        else:
            rr = 0
            hit = 0
        reciprocal_ranks.append(rr)

        if category:
            category_stats[category]["hits"].append(hit)
            category_stats[category]["rr"].append(rr)

    per_category = {
        cat: {
            "hit_rate": sum(stats["hits"]) / len(stats["hits"]),
            "mrr": sum(stats["rr"]) / len(stats["rr"]),
            "n": len(stats["hits"]),
        }
        for cat, stats in category_stats.items()
    }

    return {
        "hit_rate": hits / len(eval_set),
        "mrr": sum(reciprocal_ranks) / len(reciprocal_ranks),
        "per_category": per_category,
    }


def evaluate_retrieval(eval_set: list[dict], top_k: int = 5) -> tuple[dict, str]:
    """Returns (per_approach_metrics, best_approach_name)."""
    results = {}
    for name, search_fn in RETRIEVAL_APPROACHES.items():
        results[name] = evaluate_retrieval_approach(search_fn, eval_set, top_k=top_k)

    best = max(results, key=lambda name: (results[name]["hit_rate"], results[name]["mrr"]))
    return results, best


# =============================================================================
# 2. Generation evaluation — compare multiple prompts via LLM-as-judge
# =============================================================================

PROMPT_VARIANTS = {
    "default": SYSTEM_PROMPT,  # the prompt actually shipped in rag/generation.py
    "concise": """You are a terse database documentation assistant. Answer
in at most two short sentences, using ONLY the provided context. If the
answer isn't in the context, say so in one sentence. Do not cite sources
or add caveats beyond that.""",
}


def generate_with_prompt(question: str, contexts: list[dict], system_prompt: str) -> str:
    client = _get_client()
    response = chat_completion_with_retry(
        client,
        model=LLM_MODEL,
        messages=[
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": build_prompt(question, contexts)},
        ],
        temperature=0.1,
    )
    return response.choices[0].message.content


def judge_answer(question: str, answer: str) -> int:
    """LLM-as-judge: score 1 (unhelpful) to 5 (excellent) for how well the
    answer addresses the question. Returns 0 if the judge's reply can't be
    parsed (treated as a failing score, not a crash)."""
    client = _get_client()
    judge_prompt = (
        f"Question: {question}\nAnswer: {answer}\n\n"
        "Rate how relevant and helpful this answer is to the question, "
        "on a scale of 1 (not helpful) to 5 (excellent). "
        "Reply with ONLY a single digit, nothing else."
    )
    response = chat_completion_with_retry(
        client,
        model=LLM_MODEL,
        messages=[{"role": "user", "content": judge_prompt}],
        temperature=0,
    )
    match = re.search(r"\d", response.choices[0].message.content)
    return int(match.group()) if match else 0


def evaluate_generation(eval_set: list[dict], top_k: int = 5) -> tuple[dict, str]:
    """Returns (per_prompt_avg_score, best_prompt_name)."""
    results = {}
    for name, prompt in PROMPT_VARIANTS.items():
        scores = []
        for item in eval_set:
            contexts = hybrid_search(item["question"], top_k=top_k)
            answer = generate_with_prompt(item["question"], contexts, prompt)
            scores.append(judge_answer(item["question"], answer))
        results[name] = sum(scores) / len(scores)

    best = max(results, key=results.get)
    return results, best


# =============================================================================
# 3. SQL generation evaluation — NL question -> SQL, checked against a
#    held-out (id, NL, SQL) set
# =============================================================================

SQL_SYSTEM_PROMPT = """You are a SQL generation assistant for a healthcare
database. Given a natural-language question and schema context describing
relevant tables/columns, output ONLY a single valid SQL query that answers
the question. Do not include explanations, markdown fences, or commentary
of any kind — the entire reply must be the SQL statement itself."""


def _normalize_sql(sql: str) -> str:
    """Loose normalization so harmless formatting differences (case,
    whitespace, trailing semicolons, quote style) don't count as
    mismatches. This is intentionally NOT a full SQL-equivalence check —
    it catches "same query, different formatting", not "different query,
    same result". If you have a test database available, swap the
    comparison in evaluate_sql_generation for an execution-based check
    (run both queries, compare result sets) for a much stronger signal.
    """
    s = sql.strip().rstrip(";").lower()
    s = re.sub(r"\s+", " ", s)
    s = s.replace('"', "'")
    return s


def generate_sql(question: str, top_k: int = 5) -> str:
    """Retrieves schema context via the production retrieval path
    (hybrid_search_reranked) and asks the LLM to produce a SQL query for
    the question."""
    client = _get_client()
    contexts = hybrid_search_reranked(question, top_k=top_k)
    response = chat_completion_with_retry(
        client,
        model=LLM_MODEL,
        messages=[
            {"role": "system", "content": SQL_SYSTEM_PROMPT},
            {"role": "user", "content": build_prompt(question, contexts)},
        ],
        temperature=0,
    )
    return response.choices[0].message.content.strip()


def evaluate_sql_generation(sql_eval_set: list[dict], top_k: int = 5) -> dict:
    """Returns {"exact_match_rate": float, "n": int, "failures": [...]}.

    "Exact match" here means "matches after normalization" (see
    _normalize_sql), not "produces the same result set" — this script
    does not execute the generated SQL against a live database.
    """
    matches = 0
    failures = []

    for item in sql_eval_set:
        generated = generate_sql(item["NL"], top_k=top_k)
        if _normalize_sql(generated) == _normalize_sql(item["SQL"]):
            matches += 1
        else:
            failures.append({
                "id": item.get("id"),
                "NL": item["NL"],
                "expected_SQL": item["SQL"],
                "generated_SQL": generated,
            })

    return {
        "exact_match_rate": matches / len(sql_eval_set),
        "n": len(sql_eval_set),
        "failures": failures,
    }


if __name__ == "__main__":
    import argparse

    parser = argparse.ArgumentParser(description="Evaluate healthcare RAG retrieval, generation, and SQL output.")
    parser.add_argument("--with-generation", action="store_true",
                        help="Run expensive LLM generation + LLM-as-judge evaluation.")
    parser.add_argument("--generation-limit", type=int, default=10,
                        help="Maximum questions used for generation evaluation (default: 10).")
    parser.add_argument("--with-sql-eval", action="store_true",
                        help="Run NL-to-SQL generation evaluation against sql_eval_questions.json.")
    parser.add_argument("--sql-eval-limit", type=int, default=10,
                        help="Maximum questions used for SQL evaluation (default: 10).")
    parser.add_argument("--sql-eval-path", type=str, default=SQL_EVAL_PATH,
                        help=f"Path to the (id, NL, SQL) eval set (default: {SQL_EVAL_PATH}).")
    parser.add_argument("--show-sql-failures", action="store_true",
                        help="Print each SQL mismatch (expected vs. generated) instead of just the rate.")
    parser.add_argument("--top-k", type=int, default=5)
    parser.add_argument("--llm-min-interval", type=float, default=MIN_INTERVAL_SECONDS,
                        help=f"Minimum seconds between LLM calls, to stay under provider "
                             f"rate limits (default: {MIN_INTERVAL_SECONDS}).")
    parser.add_argument("--llm-max-retries", type=int, default=MAX_RETRIES,
                        help=f"Max retries on rate-limit errors before giving up (default: {MAX_RETRIES}).")
    args = parser.parse_args()

    MIN_INTERVAL_SECONDS = args.llm_min_interval
    MAX_RETRIES = args.llm_max_retries

    eval_set = load_eval_set()

    print(f"=== Retrieval evaluation ({len(eval_set)} questions) ===")
    retrieval_results, best_retrieval = evaluate_retrieval(eval_set, top_k=args.top_k)
    for name, metrics in retrieval_results.items():
        marker = " <- best" if name == best_retrieval else ""
        print(f"{name:15s} hit-rate={metrics['hit_rate']:.2%}  mrr={metrics['mrr']:.3f}{marker}")

    has_categories = any(m["per_category"] for m in retrieval_results.values())
    if has_categories:
        print("\n--- Per-category breakdown (hybrid_reranked vs. others) ---")
        categories = sorted({cat for m in retrieval_results.values() for cat in m["per_category"]})
        for cat in categories:
            print(f"\n[{cat}]")
            for name in RETRIEVAL_APPROACHES:
                stats = retrieval_results[name]["per_category"].get(cat)
                if stats:
                    print(f"  {name:15s} hit-rate={stats['hit_rate']:.2%}  mrr={stats['mrr']:.3f}  (n={stats['n']})")

    if args.with_generation:
        generation_set = eval_set[:max(1, min(args.generation_limit, len(eval_set)))]
        print(f"\n=== Generation evaluation ({len(generation_set)} questions, LLM-as-judge) ===")
        print("Generation evaluation is intentionally opt-in because it makes multiple LLM calls per question.")
        generation_results, best_generation = evaluate_generation(generation_set, top_k=args.top_k)
        for name, avg_score in generation_results.items():
            marker = " <- best" if name == best_generation else ""
            print(f"{name:10s} avg_relevance_score={avg_score:.2f}/5{marker}")
    else:
        print("\nGeneration evaluation skipped. Use --with-generation for an LLM quality test.")

    if args.with_sql_eval:
        if not os.path.exists(args.sql_eval_path):
            print(f"\nSQL evaluation requested but {args.sql_eval_path} was not found — skipping.")
        else:
            sql_eval_set = load_sql_eval_set(args.sql_eval_path)
            sql_eval_set = sql_eval_set[:max(1, min(args.sql_eval_limit, len(sql_eval_set)))]
            print(f"\n=== SQL generation evaluation ({len(sql_eval_set)} questions) ===")
            print("SQL evaluation is intentionally opt-in because it makes one LLM call per question.")
            sql_results = evaluate_sql_generation(sql_eval_set, top_k=args.top_k)
            print(f"exact_match_rate={sql_results['exact_match_rate']:.2%}  (n={sql_results['n']}, "
                  f"{len(sql_results['failures'])} mismatch(es))")
            if args.show_sql_failures and sql_results["failures"]:
                print("\n--- Mismatches ---")
                for f in sql_results["failures"]:
                    print(f"\n[id={f['id']}] {f['NL']}")
                    print(f"  expected : {f['expected_SQL']}")
                    print(f"  generated: {f['generated_SQL']}")
    else:
        print("\nSQL evaluation skipped. Use --with-sql-eval to check NL-to-SQL output against sql_eval_questions.json.")
